vars.restoreLastAvatar = function()
	if not vars.settings.autoLoadAvatar or type(vars.settings.lastAvatar) ~= "table" then return false end
	local last = vars.settings.lastAvatar
	local match = nil
	for _, data in ipairs(vars.ui.savedAvatars or {}) do
		local signature = data.Signature
		if not signature and data.Properties then signature = vars.getAvatarSignature(data.Properties, data.RigType or "R6") end
		if (last.Signature and signature == last.Signature) or (last.FilePath and data.FilePath == last.FilePath) or (last.FileName and data.FileName == last.FileName) then
			match = data
			break
		end
	end
	if not match then
		vars.Status.Text = "[!] Auto-load: the last avatar could not be found in saved avatars."
		return false
	end
	vars.ui.selectedAvatar = match
	vars.placeholderMode = vars.settings.lastMethod == "placeholder"
	vars.updatePlaceholderToggleVisual()
	vars.updateRowVisuals(match)
	vars.tryOnActive = true
	vars.Status.Text = "[...] Restoring last avatar: " .. tostring(match.DisplayName or match.Name or match.Username or "avatar")
	if vars.LocalPlayer.Character then
		task.defer(function()
			if vars.scriptAlive and vars.ui.selectedAvatar == match then vars.tryOnSelectedAvatarLocally() end
		end)
	end
	return true
end

