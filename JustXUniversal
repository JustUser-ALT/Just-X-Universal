local function descriptionToSkinData(description)
    if not description or not description:IsA("HumanoidDescription") then
        error("HumanoidDescription is unavailable")
    end

    local data = {
        Properties = {},
        Accessories = {},
        Emotes = {},
        EquippedEmotes = {}
    }

    for _, property in ipairs(skinDescriptionProperties) do
        local okProperty, value = pcall(function()
            return description[property]
        end)
        if okProperty then
            if typeof(value) == "Color3" then
                data.Properties[property] = {
                    __type = "Color3",
                    R = value.R,
                    G = value.G,
                    B = value.B
                }
            elseif type(value) == "string" or type(value) == "number" or type(value) == "boolean" then
                data.Properties[property] = value
            end
        end
    end

    local okAccessories, accessories = pcall(function()
        return description:GetAccessories(true)
    end)
    if okAccessories and type(accessories) == "table" then
        for _, accessory in ipairs(accessories) do
            local accessoryType = tostring(accessory.AccessoryType or "")
            accessoryType = accessoryType:match("%.([^%.]+)$") or accessoryType
            table.insert(data.Accessories, {
                AssetId = tonumber(accessory.AssetId) or 0,
                AccessoryType = accessoryType,
                IsLayered = accessory.IsLayered == true,
                Order = tonumber(accessory.Order) or 0,
                Puffiness = tonumber(accessory.Puffiness) or 1
            })
        end
    end

    pcall(function()
        data.Emotes = description:GetEmotes()
    end)
    pcall(function()
        data.EquippedEmotes = description:GetEquippedEmotes()
    end)

    return data
end

local function skinDataToDescription(data)
    if type(data) ~= "table" or type(data.Properties) ~= "table" then
        error("Saved skin data is invalid")
    end

    local description = Instance.new("HumanoidDescription")
    for property, value in pairs(data.Properties) do
        if type(property) == "string" then
            if type(value) == "table" and value.__type == "Color3" then
                pcall(function()
                    description[property] = Color3.new(
                        tonumber(value.R) or 0,
                        tonumber(value.G) or 0,
                        tonumber(value.B) or 0
                    )
                end)
            else
                pcall(function()
                    description[property] = value
                end)
            end
        end
    end

    local accessories = {}
    for _, accessory in ipairs(type(data.Accessories) == "table" and data.Accessories or {}) do
        local accessoryType
        pcall(function()
            accessoryType = Enum.AccessoryType[accessory.AccessoryType]
        end)
        if accessoryType and tonumber(accessory.AssetId) then
            table.insert(accessories, {
                AssetId = tonumber(accessory.AssetId),
                AccessoryType = accessoryType,
                IsLayered = accessory.IsLayered == true,
                Order = tonumber(accessory.Order) or 0,
                Puffiness = tonumber(accessory.Puffiness) or 1
            })
        end
    end
    pcall(function()
        description:SetAccessories(accessories, true)
    end)
    pcall(function()
        description:SetEmotes(type(data.Emotes) == "table" and data.Emotes or {})
    end)
    pcall(function()
        description:SetEquippedEmotes(type(data.EquippedEmotes) == "table" and data.EquippedEmotes or {})
    end)

    return description
end

local function loadSkinConfig()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    local okRead, raw = pcall(function()
        if not isfile(SKIN_CONFIG) then return nil end
        return readfile(SKIN_CONFIG)
    end)
    if not okRead or type(raw) ~= "string" or raw == "" then return end

    local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okDecode or type(decoded) ~= "table" then return end

    for _, skin in ipairs(decoded) do
        if type(skin) == "table" and type(skin.Data) == "table" and type(skin.Data.Properties) == "table" then
            table.insert(skinPacks, {
                Key = tostring(skin.Key or (#skinPacks + 1)),
                Name = tostring(skin.Name or ("Skin" .. (#skinPacks + 1))),
                Data = skin.Data
            })
        end
    end
end

local function saveSkinConfig()
    if type(writefile) ~= "function" then return false end
    local okSave = pcall(function()
        writefile(SKIN_CONFIG, HttpService:JSONEncode(skinPacks))
    end)
    return okSave
end

local function getSkinNames()
    local names = {}
    for _, skin in ipairs(skinPacks) do
        table.insert(names, skin.Name .. "  [" .. skin.Key .. "]")
    end
    return names
end

local function findSkinByOption(option)
    if type(option) ~= "string" then return nil end
    local key = option:match("%[([^%]]+)%]$")
    for _, skin in ipairs(skinPacks) do
        if skin.Key == key then return skin end
    end
end

local function syncSelectedSkin()
    if skinDropdown and skinDropdown.Get then
        local ok, value = pcall(function()
            return skinDropdown:Get()
        end)
        if ok then
            local found
            if type(value) == "table" then
                for option, isSelected in pairs(value) do
                    if isSelected then
                        found = findSkinByOption(option)
                        if found then break end
                    end
                end
            else
                found = findSkinByOption(value)
            end
            selectedSkin = found
        end
    end
    return selectedSkin
end

local function getNextSkinName()
    local highest = 0
    for _, skin in ipairs(skinPacks) do
        local number = tonumber(skin.Name:match("^Skin(%d+)$"))
        if number and number > highest then highest = number end
    end
    return "Skin" .. tostring(highest + 1)
end

local function getCurrentHumanoidDescription()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then error("Current character Humanoid is unavailable") end
    return humanoid:GetAppliedDescription()
end

local function saveCurrentSkin()
    local okDescription, description = pcall(getCurrentHumanoidDescription)
    if not okDescription then
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = tostring(description), Type = "Error", Duration = 5}) end
        return
    end

    local okData, skinData = pcall(descriptionToSkinData, description)
    pcall(function() description:Destroy() end)
    if not okData then
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = tostring(skinData), Type = "Error", Duration = 5}) end
        return
    end

    local customName = tostring(skinNameInput:Get() or ""):match("^%s*(.-)%s*$")
    local savedName = customName ~= "" and customName or getNextSkinName()
    local key = HttpService:GenerateGUID(false)

    table.insert(skinPacks, {
        Key = key,
        Name = savedName,
        Data = skinData
    })

    if not saveSkinConfig() then
        table.remove(skinPacks, #skinPacks)
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Could not save the skin file. Check executor file access.", Type = "Error", Duration = 5}) end
        return
    end

    local refreshOk, refreshError = true, nil
    if skinDropdown and skinDropdown.Refresh then
        refreshOk, refreshError = pcall(function()
            skinDropdown:Refresh()
        end)
    end
    if JL.Notify then
        JL:Notify({Title = "Skin Changer", Desc = "Saved: " .. savedName, Type = "Success", Duration = 4})
        if not refreshOk then
            JL:Notify({Title = "Skin Changer", Desc = "Skin was saved, but the dropdown could not refresh: " .. tostring(refreshError), Type = "Warn", Duration = 6})
        end
    end
end

local function resolveSkinAnimationMap(description)
    local temporaryModel
    local okResolve, result = pcall(function()
        temporaryModel = Players:CreateHumanoidModelFromDescription(
            description,
            Enum.HumanoidRigType.R15
        )
        if not temporaryModel then error("Roblox could not create the temporary R15 skin resolver model") end

        local generatedAnimate = temporaryModel:FindFirstChild("Animate")
        if not generatedAnimate then error("Temporary R15 skin model has no Animate script") end

        local paths = {
            idle1 = {"idle", "Animation1"},
            idle2 = {"idle", "Animation2"},
            walk = {"walk", "WalkAnim"},
            run = {"run", "RunAnim"},
            jump = {"jump", "JumpAnim"},
            fall = {"fall", "FallAnim"},
            climb = {"climb", "ClimbAnim"},
            swim = {"swim", "Swim"},
            swimidle = {"swimidle", "SwimIdle"}
        }
        local animations = {}
        for target, path in pairs(paths) do
            local animation = findGeneratedAnimation(generatedAnimate, path)
            if animation and animation:IsA("Animation") and animation.AnimationId ~= "" then
                animations[target] = animation.AnimationId:gsub("^rbxassetid://", "")
            end
        end
        if not next(animations) then error("No animation IDs could be resolved from this skin") end
        return animations
    end)

    if temporaryModel then
        pcall(function() temporaryModel:Destroy() end)
    end
    if not okResolve then error(result) end
    return result
end

local function getLoadedAsset(assetId)
    if type(game.GetObjects) ~= "function" then
        error("This executor does not support game:GetObjects")
    end
    local okLoad, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(assetId))
    end)
    if not okLoad or type(objects) ~= "table" or #objects == 0 then
        error("Could not load asset " .. tostring(assetId) .. ": " .. tostring(objects))
    end
    return objects
end

local function findAssetClass(objects, className)
    for _, root in ipairs(objects) do
        if root:IsA(className) then return root end
        for _, descendant in ipairs(root:GetDescendants()) do
            if descendant:IsA(className) then return descendant end
        end
    end
end

local function clearLocalSkinInstances(character)
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants")
            or child:IsA("ShirtGraphic") or child:IsA("BodyColors") then
            child:Destroy()
        end
    end
    local head = character:FindFirstChild("Head")
    if head then
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("Decal") and child.Name:lower() == "face" then
                child:Destroy()
            end
        end
    end
end

local function applyLocalBodyColors(character, properties)
    local bodyColors
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("BodyColors") then bodyColors = child break end
    end
    if not bodyColors then
        bodyColors = Instance.new("BodyColors")
        bodyColors.Parent = character
    end

    local colorMap = {
        HeadColor = "HeadColor3",
        TorsoColor = "TorsoColor3",
        LeftArmColor = "LeftArmColor3",
        RightArmColor = "RightArmColor3",
        LeftLegColor = "LeftLegColor3",
        RightLegColor = "RightLegColor3"
    }
    for property, bodyProperty in pairs(colorMap) do
        local saved = properties[property]
        if type(saved) == "table" and saved.__type == "Color3" then
            local color = Color3.new(
                tonumber(saved.R) or 0,
                tonumber(saved.G) or 0,
                tonumber(saved.B) or 0
            )
            pcall(function() bodyColors[bodyProperty] = color end)
            local partName = property:gsub("Color$", "")
            local part = character:FindFirstChild(partName)
            if part and part:IsA("BasePart") then part.Color = color end
        end
    end
end

local function attachLocalAccessory(character, accessory)
    local handle = accessory:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then
        error("Accessory has no valid Handle")
    end

    local bodyAttachments = {}
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Attachment") and descendant.Parent and descendant.Parent:IsA("BasePart") then
            bodyAttachments[descendant.Name] = descendant
        end
    end

    local accessoryAttachment
    local bodyAttachment
    for _, descendant in ipairs(handle:GetDescendants()) do
        if descendant:IsA("Attachment") then
            local matching = bodyAttachments[descendant.Name]
            if matching then
                accessoryAttachment = descendant
                bodyAttachment = matching
                break
            end
        end
    end

    if not accessoryAttachment or not bodyAttachment then
        error("No matching body attachment found for " .. accessory.Name)
    end

    accessory.Parent = character
    handle.Anchored = false
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.CFrame = bodyAttachment.WorldCFrame * accessoryAttachment.CFrame:Inverse()

    for _, descendant in ipairs(handle:GetDescendants()) do
        if descendant:IsA("Weld") or descendant:IsA("WeldConstraint") then
            descendant:Destroy()
        end
    end

    local weld = Instance.new("WeldConstraint")
    weld.Name = "JustXSkinAccessoryWeld"
    weld.Part0 = handle
    weld.Part1 = bodyAttachment.Parent
    weld.Parent = handle
    return true
end

local function addLocalAsset(character, humanoid, assetId, className)
    assetId = tonumber(assetId)
    if not assetId or assetId <= 0 then return false end
    local objects = getLoadedAsset(assetId)
    local source = findAssetClass(objects, className)
    if not source then
        for _, object in ipairs(objects) do pcall(function() object:Destroy() end) end
        error("Asset " .. tostring(assetId) .. " did not contain " .. className)
    end

    local clone = source:Clone()
    local okAdd, addError = true, nil
    if clone:IsA("Accessory") then
        okAdd, addError = pcall(attachLocalAccessory, character, clone)
    else
        okAdd, addError = pcall(function() clone.Parent = character end)
    end

    for _, object in ipairs(objects) do pcall(function() object:Destroy() end) end
    if not okAdd then
        pcall(function() clone:Destroy() end)
        error(addError)
    end
    return true
end

local function applyLocalSkinData(data)
    if type(data) ~= "table" or type(data.Properties) ~= "table" then
        error("Saved skin data is invalid")
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid then error("Current character is unavailable") end

    clearLocalSkinInstances(character)
    applyLocalBodyColors(character, data.Properties)

    local properties = data.Properties
    local assetWarnings = {}
    local clothing = {
        {Property = "Shirt", Class = "Shirt"},
        {Property = "Pants", Class = "Pants"},
        {Property = "GraphicTShirt", Class = "ShirtGraphic"},
        {Property = "Face", Class = "Decal"}
    }
    for _, item in ipairs(clothing) do
        local assetId = tonumber(properties[item.Property])
        if assetId and assetId > 0 then
            local okAsset, assetError = pcall(addLocalAsset, character, humanoid, assetId, item.Class)
            if not okAsset then
                table.insert(assetWarnings, item.Property .. " (" .. tostring(assetError) .. ")")
                if item.Property == "Face" then
                    local head = character:FindFirstChild("Head")
                    if head then
                        local face = Instance.new("Decal")
                        face.Name = "face"
                        face.Face = Enum.NormalId.Front
                        face.Texture = "rbxassetid://" .. tostring(assetId)
                        face.Parent = head
                    end
                end
            end
        end
    end

    for _, accessory in ipairs(type(data.Accessories) == "table" and data.Accessories or {}) do
        local assetId = tonumber(accessory.AssetId)
        if assetId and assetId > 0 then
            local okAsset, assetError = pcall(addLocalAsset, character, humanoid, assetId, "Accessory")
            if not okAsset then
                table.insert(assetWarnings, "Accessory " .. tostring(assetId) .. " (" .. tostring(assetError) .. ")")
            end
        end
    end

    if #assetWarnings > 0 then
        return true, "Some assets could not be loaded: " .. table.concat(assetWarnings, "; ")
    end
    return true
end

local function applySkinData(data, loadAnimations)
    local nextAnimationMap
    if loadAnimations then
        local okDescription, description = pcall(skinDataToDescription, data)
        if okDescription then
            local okAnimations, result = pcall(resolveSkinAnimationMap, description)
            pcall(function() description:Destroy() end)
            if okAnimations then
                nextAnimationMap = result
            elseif JL.Notify then
                JL:Notify({Title = "Skin Changer", Desc = "Skin will load, but its animations could not be resolved: " .. tostring(result), Type = "Warn", Duration = 5})
            end
        end
    end

    local okApply, applyResult, warning = pcall(applyLocalSkinData, data)
    if not okApply or not applyResult then
        if JL.Notify then
            JL:Notify({Title = "Skin Changer", Desc = tostring(okApply and warning or applyResult), Type = "Error", Duration = 5})
        end
        return false
    end

    activeSkinData = data
    if loadAnimations and nextAnimationMap then
        activeAnimationMap = nextAnimationMap
    end

    if warning and JL.Notify then
        JL:Notify({Title = "Skin Changer", Desc = warning, Type = "Warn", Duration = 7})
    end

    task.wait(0.35)
    queueAnimationReapply(true)
    return true
end

local function loadSelectedSkin()
    local skin = syncSelectedSkin()
    if not skin then
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Select a saved skin first", Type = "Info", Duration = 3}) end
        return
    end

    if not originalSkinData then
        local okOriginal, description = pcall(getCurrentHumanoidDescription)
        if okOriginal then
            local okData, data = pcall(descriptionToSkinData, description)
            pcall(function() description:Destroy() end)
            if okData then originalSkinData = data end
        end
    end

    if applySkinData(skin.Data, skinLoadAnimations) then
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Loaded: " .. skin.Name, Type = "Success", Duration = 4}) end
    end
end

local function deleteSelectedSkin()
    local skin = syncSelectedSkin()
    if not skin then
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Select a saved skin first", Type = "Info", Duration = 3}) end
        return
    end

    for index, savedSkin in ipairs(skinPacks) do
        if savedSkin.Key == skin.Key then
            table.remove(skinPacks, index)
            break
        end
    end
    selectedSkin = nil
    saveSkinConfig()
    if skinDropdown and skinDropdown.Refresh then
        skinDropdown:Refresh()
    end
    if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Deleted: " .. skin.Name, Type = "Success", Duration = 3}) end
end

local function resetSkin()
    if not originalSkinData then
        local okOriginal, description = pcall(getCurrentHumanoidDescription)
        if okOriginal then
            local okData, data = pcall(descriptionToSkinData, description)
            pcall(function() description:Destroy() end)
            if okData then originalSkinData = data end
        end
    end

    if not originalSkinData then
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Original character appearance could not be captured", Type = "Error", Duration = 4}) end
        return
    end

    local previousAnimationMap = activeAnimationMap
    activeAnimationMap = {}
    if applySkinData(originalSkinData, false) then
        activeSkinData = nil
        if JL.Notify then JL:Notify({Title = "Skin Changer", Desc = "Original skin restored", Type = "Success", Duration = 4}) end
    else
        activeAnimationMap = previousAnimationMap
    end
end

