-- Custom leaderboard. Roblox does not expose other players' Backpack contents
-- to ordinary clients; only visible/equipped tools can be listed reliably.
local leaderboardEnabled = false
local leaderboardGui
local expanded = {}
local playerWatchers = {}
local refreshPending = false
local oldPlayerListEnabled = true

local LB = {
    bg = Color3.fromRGB(22, 24, 31),
    row = Color3.fromRGB(34, 37, 47),
    text = Color3.fromRGB(240, 242, 248),
    muted = Color3.fromRGB(155, 163, 180),
    accent = Color3.fromRGB(105, 150, 255),
    border = Color3.fromRGB(65, 72, 91)
}

local function newGui(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function roundGui(obj, radius)
    newGui("UICorner", {CornerRadius = UDim.new(0, radius)}, obj)
end

local function getPlayerItems(player)
    local held, backpack = {}, {}
    local character = player.Character
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then table.insert(held, item.Name) end
        end
    end
    local pack = player:FindFirstChildOfClass("Backpack")
    if pack then
        for _, item in ipairs(pack:GetChildren()) do
            if item:IsA("Tool") then table.insert(backpack, item.Name) end
        end
    end
    table.sort(held)
    table.sort(backpack)
    return held, backpack, pack ~= nil
end

local function renderLeaderboard()
    if not leaderboardEnabled or not leaderboardGui or not leaderboardGui.Parent then return end
    local list = leaderboardGui:FindFirstChild("PlayerRows")
    if not list then return end

    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    table.sort(players, function(a, b)
        if a == LocalPlayer then return b ~= LocalPlayer end
        if b == LocalPlayer then return false end
        return a.Name:lower() < b.Name:lower()
    end)

    if #players == 0 then
        newGui("TextLabel", {
            Name = "EmptyState",
            Size = UDim2.new(1, -8, 0, 36),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = LB.muted,
            Text = "No players found",
            LayoutOrder = 1
        }, list)
    end

    for index, player in ipairs(players) do
        local okRow, rowError = pcall(function()
            local isOpen = expanded[player] == true
            local held, backpack, hasBackpack = getPlayerItems(player)
            local row = newGui("Frame", {
                Name = "Row_" .. player.UserId,
                Size = UDim2.new(1, -8, 0, isOpen and 92 or 44),
                BackgroundColor3 = LB.row,
                BorderSizePixel = 0,
                LayoutOrder = index
            }, list)
            roundGui(row, 8)

            local header = newGui("TextButton", {
                Name = "Header",
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundTransparency = 1,
                Text = "",
                AutoButtonColor = false
            }, row)

            local avatar = newGui("ImageLabel", {
                Size = UDim2.new(0, 32, 0, 32),
                Position = UDim2.new(0, 7, 0, 6),
                BackgroundColor3 = LB.bg,
                BorderSizePixel = 0
            }, header)
            roundGui(avatar, 16)
            task.spawn(function()
                local okThumb, image = pcall(function()
                    return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                end)
                if okThumb and avatar.Parent then avatar.Image = image end
            end)

            newGui("TextLabel", {
                Position = UDim2.new(0, 47, 0, 5),
                Size = UDim2.new(1, -78, 0, 17),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamSemibold,
                TextSize = 12,
                TextColor3 = LB.text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = player.DisplayName
            }, header)
            newGui("TextLabel", {
                Position = UDim2.new(0, 47, 0, 21),
                Size = UDim2.new(1, -78, 0, 14),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextSize = 10,
                TextColor3 = LB.muted,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "@" .. player.Name
            }, header)
            newGui("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0, 22),
                Size = UDim2.new(0, 18, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextSize = 14,
                TextColor3 = LB.muted,
                Text = isOpen and "⌃" or "⌄"
            }, header)

            header.MouseButton1Click:Connect(function()
                expanded[player] = not expanded[player]
                scheduleLeaderboardRefresh()
            end)

            if isOpen then
                local heldText = #held > 0 and table.concat(held, ", ") or "Nothing"
                local backpackText = hasBackpack and (#backpack > 0 and table.concat(backpack, ", ") or "Empty") or "Not replicated to this client"
                newGui("TextLabel", {
                    Position = UDim2.new(0, 10, 0, 47),
                    Size = UDim2.new(1, -20, 0, 39),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.Gotham,
                    TextSize = 10,
                    TextColor3 = LB.muted,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    TextWrapped = true,
                    Text = "Equipped: " .. heldText .. "\\nBackpack: " .. backpackText
                }, row)
            end
        end)
        if not okRow then
            warn("[Just X Universal] Leaderboard row error:", player.Name, rowError)
        end
    end

    task.defer(function()
        if list.Parent then
            local layout = list:FindFirstChildOfClass("UIListLayout")
            if layout then
                list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
            end
        end
    end)
end

local function scheduleLeaderboardRefresh()
    if refreshPending then return end
    refreshPending = true
    task.defer(function()
        refreshPending = false
        local okRender, renderError = pcall(renderLeaderboard)
        if not okRender then
            warn("[Just X Universal] Leaderboard refresh failed:", renderError)
        end
    end)
end

local function watchLeaderboardPlayer(player)
    if playerWatchers[player] then
        for _, conn in ipairs(playerWatchers[player]) do conn:Disconnect() end
    end
    local connections = {}
    playerWatchers[player] = connections
    local function watchCharacter(character)
        table.insert(connections, character.ChildAdded:Connect(scheduleLeaderboardRefresh))
        table.insert(connections, character.ChildRemoved:Connect(scheduleLeaderboardRefresh))
        scheduleLeaderboardRefresh()
    end
    table.insert(connections, player.CharacterAdded:Connect(watchCharacter))
    table.insert(connections, player.CharacterRemoving:Connect(scheduleLeaderboardRefresh))
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        table.insert(connections, backpack.ChildAdded:Connect(scheduleLeaderboardRefresh))
        table.insert(connections, backpack.ChildRemoved:Connect(scheduleLeaderboardRefresh))
    end
    if player.Character then watchCharacter(player.Character) end
end

local function destroyLeaderboard()
    if leaderboardGui then leaderboardGui:Destroy(); leaderboardGui = nil end
    for player, connections in pairs(playerWatchers) do
        for _, conn in ipairs(connections) do conn:Disconnect() end
        playerWatchers[player] = nil
    end
    table.clear(expanded)
end

local function createLeaderboard()
    destroyLeaderboard()
    leaderboardGui = newGui("ScreenGui", {
        Name = "JustXCustomLeaderboard",
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        DisplayOrder = 50,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    }, LocalPlayer:WaitForChild("PlayerGui"))

    local panel = newGui("Frame", {
        Name = "Panel",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 48),
        Size = UDim2.new(0, 238, 0, 300),
        BackgroundColor3 = LB.bg,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0
    }, leaderboardGui)
    roundGui(panel, 10)
    newGui("UIStroke", {Color = LB.border, Thickness = 1, Transparency = 0.25}, panel)

    local title = newGui("TextLabel", {
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -24, 0, 36),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = LB.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "PLAYERS"
    }, panel)

    local list = newGui("ScrollingFrame", {
        Name = "PlayerRows",
        Position = UDim2.new(0, 4, 0, 38),
        Size = UDim2.new(1, -8, 1, -44),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = LB.accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y
    }, panel)
    newGui("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, list)
    newGui("UIPadding", {
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 4)
    }, list)

    -- Drag the panel by its title area (works with mouse and touch).
    local dragging, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = panel.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)

    for _, player in ipairs(Players:GetPlayers()) do watchLeaderboardPlayer(player) end
    scheduleLeaderboardRefresh()
end

local function setLeaderboard(enabled)
    leaderboardEnabled = enabled
    if enabled then
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
        end)
        createLeaderboard()
    else
        destroyLeaderboard()
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
        end)
    end
end

