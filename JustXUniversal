-- Just X Universal
-- Universal utilities: Max Zoom + Custom Leaderboard
-- Note: Roblox does not replicate other players' Backpack contents to clients.
-- The leaderboard can show equipped Tools; full inventory requires server/game support.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local LIBRARY_URL = "https://raw.githubusercontent.com/JustUser-ALT/JustXHub/main/Library"
local JL
local ok, result = pcall(function()
    return loadstring(game:HttpGet(LIBRARY_URL))()
end)
if not ok or type(result) ~= "table" then
    warn("[Just X Universal] Failed to load JustXHub Library:", result)
    return
end
JL = result

local Window = JL:Window({
    Title = "Just X Universal",
    Columns = 2
})

local Main = Window:Tab({
    Name = "Main",
    Icon = "⌂",
    Type = "Grid"
})

local Camera = Main:Section({
    Title = "Camera",
    Column = 1
})

local Misc = Window:Tab({
    Name = "Misc",
    Icon = "☷",
    Type = "List"
})

local MiscSection = Misc:Section({
    Title = "Player List"
})

local maxZoomValue = LocalPlayer.CameraMaxZoomDistance
Camera:Slider({
    Name = "Max Zoom",
    Min = 1,
    Max = 10000,
    Step = 1,
    Default = math.clamp(maxZoomValue, 1, 10000),
    Flag = "JXU_MaxZoom",
    Callback = function(value)
        LocalPlayer.CameraMaxZoomDistance = value
    end
})

LocalPlayer:GetPropertyChangedSignal("CameraMaxZoomDistance"):Connect(function()
    maxZoomValue = LocalPlayer.CameraMaxZoomDistance
end)

-- Custom leaderboard
local leaderboardEnabled = false
local leaderboardGui
local playerConnections = {}
local rowByPlayer = {}
local expandedByPlayer = {}
local refreshQueued = false

local COLORS = {
    background = Color3.fromRGB(20, 22, 29),
    row = Color3.fromRGB(30, 33, 43),
    rowHover = Color3.fromRGB(39, 43, 56),
    text = Color3.fromRGB(240, 242, 248),
    muted = Color3.fromRGB(153, 160, 177),
    accent = Color3.fromRGB(120, 155, 255),
    border = Color3.fromRGB(66, 72, 91),
}

local function make(className, props, parent)
    local obj = Instance.new(className)
    for key, value in pairs(props or {}) do
        obj[key] = value
    end
    obj.Parent = parent
    return obj
end

local function round(instance, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, instance)
end

local function addStroke(instance)
    make("UIStroke", {
        Color = COLORS.border,
        Thickness = 1,
        Transparency = 0.35,
    }, instance)
end

local function getHeldTools(player)
    local result = {}
    local character = player.Character
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then
                table.insert(result, child.Name)
            end
        end
    end
    table.sort(result)
    return result
end

local function inventoryText(player)
    local held = getHeldTools(player)
    local lines = {}

    if #held == 0 then
        table.insert(lines, "In hand: nothing")
    else
        table.insert(lines, "In hand: " .. table.concat(held, ", "))
    end

    -- Backpack contents of other players are not replicated to this client in normal Roblox.
    table.insert(lines, "Backpack: unavailable (not replicated by Roblox)")
    return table.concat(lines, "\n")
end

local function clearRows()
    for player, row in pairs(rowByPlayer) do
        if row and row.Parent then
            row:Destroy()
        end
        rowByPlayer[player] = nil
    end
end

local function buildPlayerRow(player, order)
    local rowHeight = expandedByPlayer[player] and 84 or 42
    local row = make("Frame", {
        Name = "Player_" .. player.UserId,
        Size = UDim2.new(1, -8, 0, rowHeight),
        BackgroundColor3 = COLORS.row,
        BorderSizePixel = 0,
        LayoutOrder = order,
    }, leaderboardGui.List)
    round(row, 8)

    local click = make("TextButton", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, row)

    local avatar = make("ImageLabel", {
        Name = "Avatar",
        Position = UDim2.new(0, 7, 0, 6),
        Size = UDim2.new(0, 30, 0, 30),
        BackgroundColor3 = COLORS.background,
        BorderSizePixel = 0,
        Image = "",
    }, click)
    round(avatar, 15)

    task.spawn(function()
        local success, image = pcall(function()
            return Players:GetUserThumbnailAsync(
                player.UserId,
                Enum.ThumbnailType.HeadShot,
                Enum.ThumbnailSize.Size48x48
            )
        end)
        if success and avatar.Parent then
            avatar.Image = image
        end
    end)

    make("TextLabel", {
        Name = "DisplayName",
        Position = UDim2.new(0, 44, 0, 4),
        Size = UDim2.new(1, -76, 0, 17),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextColor3 = COLORS.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = player.DisplayName,
    }, click)

    make("TextLabel", {
        Name = "Username",
        Position = UDim2.new(0, 44, 0, 20),
        Size = UDim2.new(1, -76, 0, 15),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextColor3 = COLORS.muted,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = "@" .. player.Name,
    }, click)

    make("TextLabel", {
        Name = "Arrow",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0, 21),
        Size = UDim2.new(0, 18, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        TextColor3 = COLORS.muted,
        Text = expandedByPlayer[player] and "⌃" or "⌄",
    }, click)

    click.MouseButton1Click:Connect(function()
        expandedByPlayer[player] = not expandedByPlayer[player]
        refreshQueued = true
    end)

    if expandedByPlayer[player] then
        make("TextLabel", {
            Name = "Inventory",
            Position = UDim2.new(0, 10, 0, 44),
            Size = UDim2.new(1, -20, 0, 34),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextColor3 = COLORS.muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            Text = inventoryText(player),
        }, row)
    end

    rowByPlayer[player] = row
end

local function refreshLeaderboard()
    if not leaderboardEnabled or not leaderboardGui then
        return
    end

    clearRows()
    local list = Players:GetPlayers()
    table.sort(list, function(a, b)
        if a == LocalPlayer then return true end
        if b == LocalPlayer then return false end
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    for index, player in ipairs(list) do
        buildPlayerRow(player, index)
    end

    local layout = leaderboardGui.List:FindFirstChildOfClass("UIListLayout")
    if layout then
        leaderboardGui.List.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end
end

local function queueRefresh()
    if refreshQueued then return end
    refreshQueued = true
    task.defer(function()
        refreshQueued = false
        refreshLeaderboard()
    end)
end

local function destroyLeaderboard()
    if leaderboardGui then
        leaderboardGui:Destroy()
        leaderboardGui = nil
    end
    clearRows()
    rowByPlayer = {}
end

local function createLeaderboard()
    destroyLeaderboard()

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    leaderboardGui = make("ScreenGui", {
        Name = "JustXCustomLeaderboard",
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        DisplayOrder = 20,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui)

    local panel = make("Frame", {
        Name = "Panel",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -10, 0, 42),
        Size = UDim2.new(0, 218, 0, 270),
        BackgroundColor3 = COLORS.background,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
    }, leaderboardGui)
    round(panel, 10)
    addStroke(panel)

    make("TextLabel", {
        Name = "Title",
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -24, 0, 34),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = COLORS.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = "PLAYERS",
    }, panel)

    local list = make("ScrollingFrame", {
        Name = "List",
        Position = UDim2.new(0, 4, 0, 36),
        Size = UDim2.new(1, -8, 1, -42),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = COLORS.accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, panel)

    make("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)

    make("UIPadding", {
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 4),
    }, list)

    refreshLeaderboard()
end

local function setLeaderboardEnabled(enabled)
    leaderboardEnabled = enabled

    if enabled then
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
        end)
        createLeaderboard()
    else
        destroyLeaderboard()
        pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
        end)
    end
end

MiscSection:Toggle({
    Name = "Custom Leaderboard",
    Default = false,
    Flag = "JXU_CustomLeaderboard",
    Callback = function(enabled)
        setLeaderboardEnabled(enabled)
    end
})

Players.PlayerAdded:Connect(queueRefresh)
Players.PlayerRemoving:Connect(function(player)
    expandedByPlayer[player] = nil
    queueRefresh()
end)

for _, player in ipairs(Players:GetPlayers()) do
    player.CharacterAdded:Connect(queueRefresh)
    player.CharacterRemoving:Connect(queueRefresh)
end

print("[Just X Universal] Loaded: Max Zoom + Custom Leaderboard")
