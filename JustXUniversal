                if #items == 0 then
                    return '<font color="#9BA3B4">' .. escapeRichText(emptyText) .. '</font>'
                end
                local names = {}
                for _, itemName in ipairs(items) do
                    table.insert(names, '<font color="#' .. color:ToHex() .. '">' .. escapeRichText(itemName) .. '</font>')
