+-- ====================================================================
+-- ENTITY IMPORT  (inserted before "bindCharacterLifecycle" startup call)
+-- Captures an in-game Model by path, lists it next to saved avatars,
+-- and wears it locally: clone glued to the real character, real
+-- character hidden locally, every entity part non-colliding/non-touchable.
+-- Local-only: other players never see it.
+-- ====================================================================
+
+vars.ENTITY_FILE_PATH = vars.FOLDER_NAME .. "/SavedEntities.json"
+vars.ENTITY_RESOLVE_TIMEOUT = 3      -- seconds per path segment (StreamingEnabled waits)
+vars.ENTITY_SAMPLE_SECONDS = 6       -- how long to watch the source for playing animations
+vars.ENTITY_SCALE_MIN = 0.05
+vars.ENTITY_SCALE_MAX = 100
+
+vars.ENTITY_DEFAULT_OPTIONS = {
+	scale = "native",   -- "native" | "fit" | number as text
+	yaw = 0,            -- degrees added to the facing; UNCALIBRATED, depends on how the rig's root is oriented
+	yOffset = 0,        -- studs added after ground alignment
+	alignGround = true, -- entity visual bottom on the player's floor
+	recenter = true,    -- entity visual centre (XZ) under the player's root
+	sounds = false,
+	runSpeed = 20,      -- studs/s at which the "run" animation replaces "walk"; UNCALIBRATED
+	animMap = "",       -- "idle=Name; run=rbxassetid://123"
+}
+
+vars.ENTITY_SLOT_LOOPED = {
+	idle = true, walk = true, run = true, climb = true, swim = true,
+	swimidle = true, sit = true, fall = true, jump = false,
+}
+vars.ENTITY_SLOT_FALLBACK = {
+	idle = {"idle"},
+	walk = {"walk", "run", "idle"},
+	run = {"run", "walk", "idle"},
+	jump = {"jump", "fall", "idle"},
+	fall = {"fall", "jump", "idle"},
+	climb = {"climb", "idle"},
+	swim = {"swim", "walk", "idle"},
+	swimidle = {"swimidle", "idle"},
+	sit = {"sit", "idle"},
+}
+
+vars.entityEntries = {}
+vars.entitiesLoaded = false
+vars.entityRuntime = nil
+vars.entityPanelEntry = nil
+
+-- ---------------------------------------------------------------- pure helpers
+
+vars.entityTrim = function(text)
+	return (tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", ""))
+end
+
+vars.normalizeEntityOptions = function(raw)
+	raw = type(raw) == "table" and raw or {}
+	local d = vars.ENTITY_DEFAULT_OPTIONS
+	local function num(value, default, lo, hi)
+		value = tonumber(value)
+		if not value or value ~= value or value == math.huge or value == -math.huge then return default end
+		return math.clamp(value, lo, hi)
+	end
+	local function bool(value, default)
+		if type(value) == "boolean" then return value end
+		return default
+	end
+	local scale = string.lower(vars.entityTrim(raw.scale == nil and d.scale or raw.scale))
+	if scale == "" then scale = "native" end
+	if scale ~= "native" and scale ~= "fit" and not tonumber(scale) then scale = "native" end
+	return {
+		scale = scale,
+		yaw = num(raw.yaw, d.yaw, -360, 360),
+		yOffset = num(raw.yOffset, d.yOffset, -1000, 1000),
+		alignGround = bool(raw.alignGround, d.alignGround),
+		recenter = bool(raw.recenter, d.recenter),
+		sounds = bool(raw.sounds, d.sounds),
+		runSpeed = num(raw.runSpeed, d.runSpeed, 0.1, 1000),
+		animMap = tostring(raw.animMap or d.animMap),
+	}
+end
+
+-- Returns tokens (strings) or nil, errorMessage.
+-- Accepts: workspace.Monsters.Mimic | game.Workspace.Monsters["Mimic"] |
+-- game:GetService("Workspace").Monsters:FindFirstChild("Mimic") | workspace/Monsters/Mimic | Mimic#2 (2nd child named Mimic)
+vars.parseInstancePath = function(text)
+	text = vars.entityTrim(text)
+	if text == "" then return nil, "path is empty" end
+	local tokens = {}
+	local i, n = 1, #text
+	while i <= n do
+		local c = text:sub(i, i)
+		if c == "." or c == "/" or c == " " then
+			i += 1
+		elseif c == "[" then
+			local quote = text:sub(i + 1, i + 1)
+			if quote ~= '"' and quote ~= "'" then return nil, "bracket index must be quoted (char " .. i .. ")" end
+			local close = text:find(quote .. "]", i + 2, true)
+			if not close then return nil, "unterminated [..] (char " .. i .. ")" end
+			tokens[#tokens + 1] = text:sub(i + 2, close - 1)
+			i = close + 2
+		elseif c == ":" then
+			local method, arg = text:match("^:(%a+)%(%s*[\"']([^\"']*)[\"']", i)
+			if not method then return nil, "unsupported method call (char " .. i .. ")" end
+			if method ~= "GetService" and method ~= "WaitForChild" and method ~= "FindFirstChild" then
+				return nil, "only GetService/WaitForChild/FindFirstChild are supported (char " .. i .. ")"
+			end
+			local closeParen = text:find(")", i, true)
+			if not closeParen then return nil, "unterminated call (char " .. i .. ")" end
+			tokens[#tokens + 1] = arg
+			i = closeParen + 1
+		else
+			local _, e = text:find("^[^%.%[:/]+", i)
+			local name = vars.entityTrim(text:sub(i, e))
+			if name ~= "" then tokens[#tokens + 1] = name end
+			i = e + 1
+		end
+	end
+	if #tokens == 0 then return nil, "no path segments found" end
+	return tokens
+end
+
+vars.getBodyRotation = function(rootCFrame)
+	local look = rootCFrame.LookVector
+	local yaw0 = 0
+	if math.abs(look.Y) < 0.98 then yaw0 = math.atan2(-look.X, -look.Z) end
+	return CFrame.Angles(0, -yaw0, 0) * rootCFrame.Rotation, yaw0
+end
+
+-- Axis-aligned bounds of all parts in the "normalized frame": origin at the root,
+-- upright, forward = -Z. visible = parts with Transparency < 0.95 (falls back to all).
+vars.computeEntityBounds = function(parts, rootCFrame, bodyRotation)
+	local function newBox()
+		return {min = Vector3.new(math.huge, math.huge, math.huge), max = Vector3.new(-math.huge, -math.huge, -math.huge), count = 0}
+	end
+	local visible, full = newBox(), newBox()
+	local function add(box, point)
+		box.min = Vector3.new(math.min(box.min.X, point.X), math.min(box.min.Y, point.Y), math.min(box.min.Z, point.Z))
+		box.max = Vector3.new(math.max(box.max.X, point.X), math.max(box.max.Y, point.Y), math.max(box.max.Z, point.Z))
+	end
+	for _, part in ipairs(parts) do
+		local size = part.Size
+		local finite = size.X == size.X and size.Y == size.Y and size.Z == size.Z
+		if finite then
+			local isVisible = part.Transparency < 0.95
+			local half = size / 2
+			for _, sx in ipairs({-1, 1}) do
+				for _, sy in ipairs({-1, 1}) do
+					for _, sz in ipairs({-1, 1}) do
+						local worldPoint = (part.CFrame * CFrame.new(sx * half.X, sy * half.Y, sz * half.Z)).Position
+						local normalized = bodyRotation:VectorToWorldSpace(rootCFrame:PointToObjectSpace(worldPoint))
+						add(full, normalized)
+						if isVisible then add(visible, normalized) end
+					end
+				end
+			end
+			full.count += 1
+			if isVisible then visible.count += 1 end
+		end
+	end
+	if full.count == 0 then return nil end
+	local used = visible.count > 0 and visible or full
+	return {
+		min = used.min,
+		max = used.max,
+		size = used.max - used.min,
+		center = (used.min + used.max) / 2,
+		fullSize = full.max - full.min,
+		visibleOnly = used == visible and visible.count < full.count,
+	}
+end
+
+vars.resolveEntityScale = function(spec, entityHeight, playerHeight)
+	local text = string.lower(vars.entityTrim(spec))
+	local value = 1
+	if text == "fit" then
+		if entityHeight and entityHeight > 0 and playerHeight and playerHeight > 0 then value = playerHeight / entityHeight end
+	elseif text ~= "" and text ~= "native" then
+		value = tonumber(text) or 1
+	end
+	if value ~= value then value = 1 end
+	return math.clamp(value, vars.ENTITY_SCALE_MIN, vars.ENTITY_SCALE_MAX)
+end
+
+vars.classifyEntityAnimation = function(name, group)
+	local s = string.lower(tostring(group or "") .. " " .. tostring(name or ""))
+	local function has(...)
+		for _, key in ipairs({...}) do
+			if s:find(key, 1, true) then return true end
+		end
+		return false
+	end
+	if has("swimidle") or (has("swim") and has("idle")) then return "swimidle" end
+	if has("swim") then return "swim" end
+	if has("climb", "ladder") then return "climb" end
+	if has("sit", "seat") then return "sit" end
+	if has("jump", "leap") then return "jump" end
+	if has("fall") then return "fall" end
+	if has("run", "sprint", "chase") then return "run" end
+	if has("walk", "move", "stroll", "crawl", "slither") then return "walk" end
+	if has("idle", "stand", "breath") then return "idle" end
+	return nil
+end
+
+vars.buildEntitySlots = function(animations, mapText)
+	local slots, warnings = {}, {}
+	for _, anim in ipairs(animations or {}) do
+		local slot = vars.classifyEntityAnimation(anim.Name, anim.Group)
+		if slot and not slots[slot] then slots[slot] = anim end
+	end
+	mapText = vars.entityTrim(mapText)
+	if mapText ~= "" then
+		for piece in mapText:gmatch("[^;,\n]+") do
+			local key, value = piece:match("^%s*([%w_]+)%s*=%s*(.-)%s*$")
+			if key then
+				key = string.lower(key)
+				if vars.ENTITY_SLOT_LOOPED[key] == nil then
+					warnings[#warnings + 1] = "unknown slot '" .. key .. "'"
+				elseif string.lower(value) == "none" or string.lower(value) == "off" then
+					slots[key] = nil
+				else
+					local digits = value:match("^rbxassetid://(%d+)$") or value:match("^(%d+)$")
+					if digits then
+						slots[key] = {Id = "rbxassetid://" .. digits, Name = "map:" .. key, Group = "", Source = "map"}
+					else
+						local found
+						for _, anim in ipairs(animations or {}) do
+							if string.lower(anim.Name) == string.lower(value) then found = anim break end
+						end
+						if found then slots[key] = found else warnings[#warnings + 1] = "no animation named '" .. value .. "'" end
+					end
+				end
+			end
+		end
+	end
+	return slots, warnings
+end
+
+vars.pickEntitySlot = function(motion, slots, runSpeed)
+	local wanted
+	if motion.seated then
+		wanted = "sit"
+	elseif motion.climbing then
+		wanted = "climb"
+	elseif motion.swimming then
+		wanted = motion.speed > 1 and "swim" or "swimidle"
+	elseif motion.jumping then
+		wanted = "jump"
+	elseif motion.falling then
+		wanted = "fall"
+	elseif motion.speed > 0.5 then
+		wanted = motion.speed >= runSpeed and "run" or "walk"
+	else
+		wanted = "idle"
+	end
+	for _, candidate in ipairs(vars.ENTITY_SLOT_FALLBACK[wanted]) do
+		if slots[candidate] then return candidate end
+	end
+	return nil
+end
+
+vars.pickEntityRoot = function(model)
+	local primary = model.PrimaryPart
+	if primary and primary:IsA("BasePart") then return primary, "PrimaryPart" end
+	local hrp = model:FindFirstChild("HumanoidRootPart", true)
+	if hrp and hrp:IsA("BasePart") then return hrp, "HumanoidRootPart" end
+	for _, name in ipairs({"RootPart", "Root", "Torso", "UpperTorso", "Body", "Main"}) do
+		local part = model:FindFirstChild(name, true)
+		if part and part:IsA("BasePart") then return part, "name match '" .. name .. "'" end
+	end
+	local best, bestVolume
+	for _, descendant in ipairs(model:GetDescendants()) do
+		if descendant:IsA("BasePart") then
+			local volume = descendant.Size.X * descendant.Size.Y * descendant.Size.Z
+			if not bestVolume or volume > bestVolume then best, bestVolume = descendant, volume end
+		end
+	end
+	if best then return best, "largest part (no PrimaryPart / HumanoidRootPart)" end
+	return nil, "no BaseParts"
+end
+
+-- ---------------------------------------------------------------- resolve + capture
+
+vars.findChildForPath = function(parent, name, timeout)
+	local direct = parent:FindFirstChild(name)
+	if direct then return direct end
+	local base, index = name:match("^(.-)#(%d+)$")
+	if base and index then
+		local count = 0
+		for _, child in ipairs(parent:GetChildren()) do
+			if child.Name == base then
+				count += 1
+				if count == tonumber(index) then return child end
+			end
+		end
+	end
+	return parent:WaitForChild(name, timeout)
+end
+
+vars.resolveInstancePath = function(text, timeout)
+	local tokens, parseError = vars.parseInstancePath(text)
+	if not tokens then return nil, parseError end
+	local first = tokens[1]
+	local current
+	if string.lower(first) == "game" then
+		current = game
+	elseif string.lower(first) == "workspace" then
+		current = vars.Workspace
+	else
+		local ok, service = pcall(function() return game:GetService(first) end)
+		current = ok and service or game:FindFirstChild(first)
+		if not current then return nil, "unknown root '" .. first .. "'" end
+	end
+	for index = 2, #tokens do
+		local name = tokens[index]
+		local nextInstance
+		if current == game then
+			local ok, service = pcall(function() return game:GetService(name) end)
+			nextInstance = ok and service or game:FindFirstChild(name)
+		else
+			nextInstance = vars.findChildForPath(current, name, timeout)
+		end
+		if not nextInstance then
+			return nil, "'" .. name .. "' not found under " .. current:GetFullName()
+				.. " (wrong path, or not streamed in yet: walk near it and retry)"
+		end
+		current = nextInstance
+	end
+	return current
+end
+
+vars.getEntityLeafName = function(path)
+	local tokens = vars.parseInstancePath(path)
+	return tokens and tokens[#tokens] or tostring(path)
+end
+
+vars.captureEntity = function(path, options)
+	local source, resolveError = vars.resolveInstancePath(path, vars.ENTITY_RESOLVE_TIMEOUT)
+	if not source then return nil, resolveError end
+	if not vars.scriptAlive then return nil, "script unloaded" end
+
+	local isModel = source:IsA("Model")
+	local isPart = source:IsA("BasePart")
+	if not isModel and not isPart then
+		return nil, source:GetFullName() .. " is a " .. source.ClassName .. "; need a Model or a BasePart"
+	end
+
+	local info = {Warnings = {}, Animations = {}, Removed = {Scripts = 0, Joints = 0, Constraints = 0}, SourceName = source:GetFullName(), SourceClass = source.ClassName}
+
+	local unlocked = {}
+	local function unlock(instance)
+		if not instance.Archivable then
+			unlocked[#unlocked + 1] = instance
+			pcall(function() instance.Archivable = true end)
+		end
+	end
+	unlock(source)
+	for _, descendant in ipairs(source:GetDescendants()) do unlock(descendant) end
+	local okClone, clone = pcall(function() return source:Clone() end)
+	for _, instance in ipairs(unlocked) do pcall(function() instance.Archivable = false end) end
+	if not okClone or not clone then
+		return nil, "Clone() failed: " .. tostring(clone)
+	end
+	if #unlocked > 0 then
+		info.Warnings[#info.Warnings + 1] = #unlocked .. " non-archivable instance(s) were temporarily unlocked to copy them"
+	end
+
+	if isPart and not isModel then
+		local wrapper = Instance.new("Model")
+		wrapper.Name = clone.Name
+		clone.Parent = wrapper
+		wrapper.PrimaryPart = clone
+		clone = wrapper
+	end
+
+	if vars.Workspace.StreamingEnabled and isModel then
+		local okMode, mode = pcall(function() return source.ModelStreamingMode end)
+		if okMode and mode ~= Enum.ModelStreamingMode.Persistent and mode ~= Enum.ModelStreamingMode.Atomic then
+			info.Warnings[#info.Warnings + 1] = "StreamingEnabled and the model is not Atomic/Persistent: the copy may be missing streamed-out parts"
+		end
+	end
+
+	-- animations first (scripts that hold them are removed below)
+	local seenIds = {}
+	local function addAnimation(id, name, group, sourceKind)
+		id = tostring(id or "")
+		if id == "" or seenIds[id] then return end
+		seenIds[id] = true
+		info.Animations[#info.Animations + 1] = {Id = id, Name = tostring(name or "Animation"), Group = tostring(group or ""), Source = sourceKind}
+	end
+	local descendants = clone:GetDescendants()
+	for _, instance in ipairs(descendants) do
+		if instance:IsA("Animation") then
+			local group = instance.Parent and not instance.Parent:IsA("Model") and instance.Parent.Name or ""
+			addAnimation(instance.AnimationId, instance.Name, group, "instance")
+		end
+	end
+	info.AnimatorCount = 0
+	local sourceAnimators = {}
+	for _, instance in ipairs(source:GetDescendants()) do
+		if instance:IsA("Animator") then sourceAnimators[#sourceAnimators + 1] = instance end
+	end
+	info.AnimatorCount = #sourceAnimators
+
+	-- sanitize
+	local toDestroy = {}
+	for _, instance in ipairs(descendants) do
+		if instance:IsA("LuaSourceContainer") and not instance:IsA("ModuleScript") then
+			toDestroy[#toDestroy + 1] = instance
+			info.Removed.Scripts += 1
+		elseif instance:IsA("JointInstance") or instance:IsA("WeldConstraint") then
+			local p0, p1 = instance.Part0, instance.Part1
+			if (p0 and not p0:IsDescendantOf(clone)) or (p1 and not p1:IsDescendantOf(clone)) then
+				toDestroy[#toDestroy + 1] = instance
+				info.Removed.Joints += 1
+			end
+		elseif instance:IsA("Constraint") then
+			local a0, a1 = instance.Attachment0, instance.Attachment1
+			if (a0 and not a0:IsDescendantOf(clone)) or (a1 and not a1:IsDescendantOf(clone)) then
+				toDestroy[#toDestroy + 1] = instance
+				info.Removed.Constraints += 1
+			end
+		elseif instance:IsA("Sound") then
+			pcall(function()
+				instance:SetAttribute("EntityWasPlaying", instance.Playing)
+				instance.Playing = false
+			end)
+		end
+	end
+	for _, instance in ipairs(toDestroy) do pcall(function() instance:Destroy() end) end
+	clone.Parent = nil
+
+	local parts = {}
+	local accessoryCount = 0
+	for _, instance in ipairs(clone:GetDescendants()) do
+		if instance:IsA("BasePart") then parts[#parts + 1] = instance end
+		if instance:IsA("Accessory") then accessoryCount += 1 end
+		if instance:IsA("Humanoid") then info.HasHumanoid = true end
+	end
+	if #parts == 0 then
+		pcall(function() clone:Destroy() end)
+		return nil, source:GetFullName() .. " contains no BaseParts"
+	end
+
+	local root, how = vars.pickEntityRoot(clone)
+	local bodyRotation, yaw0 = vars.getBodyRotation(root.CFrame)
+	info.Template = clone
+	info.PartCount = #parts
+	info.AccessoryCount = accessoryCount
+	info.RootName = root.Name
+	info.RootHow = how
+	info.RootYaw = yaw0
+	info.Bounds = vars.computeEntityBounds(parts, root.CFrame, bodyRotation)
+	if info.Bounds and info.Bounds.visibleOnly then
+		info.Warnings[#info.Warnings + 1] = string.format("invisible parts enlarge the full box (%.1f studs tall vs %.1f visible); placement uses visible parts", info.Bounds.fullSize.Y, info.Bounds.size.Y)
+	end
+	if math.abs(root.CFrame.UpVector.Y) < 0.9 then
+		info.Warnings[#info.Warnings + 1] = "root part is not upright in the world; the body may be tilted, adjust with yaw / check in game"
+	end
+
+	-- keep watching the original for animations it plays at runtime
+	if #sourceAnimators > 0 then
+		task.spawn(function()
+			local deadline = os.clock() + vars.ENTITY_SAMPLE_SECONDS
+			while vars.scriptAlive and os.clock() < deadline and source.Parent do
+				local added = false
+				for _, animator in ipairs(sourceAnimators) do
+					local ok, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
+					if ok and tracks then
+						for _, track in ipairs(tracks) do
+							local animation = track.Animation
+							if animation and animation.AnimationId ~= "" and not seenIds[animation.AnimationId] then
+								addAnimation(animation.AnimationId, track.Name ~= "" and track.Name or animation.Name, "", "sampled")
+								added = true
+							end
+						end
+					end
+				end
+				if added and info.OnAnimationsChanged then pcall(info.OnAnimationsChanged) end
+				task.wait(0.15)
+			end
+			info.SampleDone = true
+			if info.OnAnimationsChanged then pcall(info.OnAnimationsChanged) end
+		end)
+	else
+		info.SampleDone = true
+	end
+
+	return info
+end
+
+-- ---------------------------------------------------------------- wear
+
+vars.prepareEntityClone = function(model, options)
+	for _, instance in ipairs(model:GetDescendants()) do
+		if instance:IsA("Humanoid") then
+			instance.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
+			pcall(function() instance.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff end)
+			pcall(function() instance.RequiresNeck = false end)
+			pcall(function() instance.AutomaticScalingEnabled = false end)
+			pcall(function() instance.EvaluateStateMachine = false end)
+			pcall(function()
+				for _, state in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
+					if state ~= Enum.HumanoidStateType.None then instance:SetStateEnabled(state, false) end
+				end
+				instance:ChangeState(Enum.HumanoidStateType.None)
+			end)
+		elseif instance:IsA("Sound") then
+			pcall(function() instance.Playing = options.sounds and instance:GetAttribute("EntityWasPlaying") == true end)
+		elseif instance:IsA("BillboardGui") then
+			pcall(function() instance.Enabled = false end)
+		elseif instance:IsA("ProximityPrompt") then
+			pcall(function() instance.Enabled = false end)
+		elseif instance:IsA("ClickDetector") then
+			pcall(function() instance.MaxActivationDistance = 0 end)
+		elseif instance:IsA("Seat") or instance:IsA("VehicleSeat") then
+			pcall(function() instance.Disabled = true end)
+		end
+	end
+end
+
+-- Rigidly weld every part that is not joint-connected to the root, so nothing falls or drifts.
+vars.weldDetachedParts = function(model, root)
+	local parts, parent = {}, {}
+	for _, instance in ipairs(model:GetDescendants()) do
+		if instance:IsA("BasePart") then
+			parts[#parts + 1] = instance
+			parent[instance] = instance
+		end
+	end
+	local function find(x)
+		while parent[x] ~= x do
+			parent[x] = parent[parent[x]]
+			x = parent[x]
+		end
+		return x
+	end
+	local function union(a, b)
+		a, b = find(a), find(b)
+		if a ~= b then parent[a] = b end
+	end
+	for _, instance in ipairs(model:GetDescendants()) do
+		if instance:IsA("JointInstance") or instance:IsA("WeldConstraint") then
+			local p0, p1 = instance.Part0, instance.Part1
+			if instance.Enabled and p0 and p1 and parent[p0] and parent[p1] then union(p0, p1) end
+		end
+	end
+	local welded = 0
+	for _, part in ipairs(parts) do
+		if find(part) ~= find(root) then
+			local weld = Instance.new("WeldConstraint")
+			weld.Name = "EntityGlue"
+			weld.Part0 = root
+			weld.Part1 = part
+			weld.Parent = part
+			union(part, root)
+			welded += 1
+		end
+	end
+	return welded
+end
+
+vars.getPlayerFloorBelowRoot = function(humanoid, rootPart, legPart)
+	local below = humanoid.HipHeight + rootPart.Size.Y / 2
+	if humanoid.RigType == Enum.HumanoidRigType.R6 then
+		below += legPart and legPart.Size.Y or 2
+	end
+	return below
+end
+
+vars.entityStopRuntime = function()
+	local runtime = vars.entityRuntime
+	vars.entityRuntime = nil
+	if not runtime then return end
+	for _, track in pairs(runtime.tracks) do
+		if track then pcall(function() track:Stop(0) end) end
+	end
+	for _, animation in ipairs(runtime.loadedAnimations) do pcall(function() animation:Destroy() end) end
+end
+
+vars.entityGetTrack = function(runtime, slot)
+	local cached = runtime.tracks[slot]
+	if cached ~= nil then return cached or nil end
+	local anim = runtime.slots[slot]
+	if not anim or not runtime.animator then
+		runtime.tracks[slot] = false
+		return nil
+	end
+	local ok, trackOrError = pcall(function()
+		local animation = Instance.new("Animation")
+		animation.AnimationId = anim.Id
+		runtime.loadedAnimations[#runtime.loadedAnimations + 1] = animation
+		local track = runtime.animator:LoadAnimation(animation)
+		track.Looped = vars.ENTITY_SLOT_LOOPED[slot] == true and true or track.Looped
+		return track
+	end)
+	if ok and trackOrError then
+		runtime.tracks[slot] = trackOrError
+		return trackOrError
+	end
+	runtime.tracks[slot] = false
+	runtime.animErrors[#runtime.animErrors + 1] = slot .. ": " .. tostring(trackOrError)
+	return nil
+end
+
+vars.entityStep = function()
+	if not vars.scriptAlive then return end
+	local runtime = vars.entityRuntime
+	if not runtime then return end
+
+	if not runtime.model:IsDescendantOf(vars.Workspace) or not runtime.root.Parent then
+		if vars.tryOnActive and not vars.localTryOnBuilding then
+			vars.stopLocalTryOn(false)
+			vars.Status.Text = "[!] Entity was removed by this experience. Original avatar restored."
+			vars.showDiagnostics("Entity wear unavailable in this experience.", "The cloned entity was removed after creation (the game likely purges unknown Workspace models). Your real avatar was restored.")
+		end
+		return
+	end
+
+	local character = vars.LocalPlayer.Character
+	if character ~= runtime.character or not character or not character.Parent then
+		vars.stopLocalTryOn(vars.tryOnActive)
+		vars.updateWearButtonState()
+		if vars.tryOnActive then vars.Status.Text = "[...] Character respawning..." end
+		return
+	end
+	local humanoid = runtime.humanoid
+	local hrp = runtime.hrp
+	if not humanoid.Parent or not hrp.Parent then return end
+
+	local options = runtime.options
+	local cf = hrp.CFrame
+	local look = cf.LookVector
+	local yaw = runtime.lastYaw
+	if math.abs(look.Y) < 0.98 then yaw = math.atan2(-look.X, -look.Z) end
+	runtime.lastYaw = yaw
+	local facing = CFrame.Angles(0, yaw + math.rad(options.yaw), 0)
+
+	local floorBelow = vars.getPlayerFloorBelowRoot(humanoid, hrp, runtime.legPart)
+	local offsetY
+	if options.alignGround then
+		offsetY = -floorBelow - runtime.bounds.min.Y + options.yOffset
+	else
+		offsetY = -runtime.bounds.center.Y + options.yOffset
+	end
+	local horizontal = options.recenter and facing:VectorToWorldSpace(Vector3.new(runtime.bounds.center.X, 0, runtime.bounds.center.Z)) or Vector3.zero
+	local position = Vector3.new(cf.Position.X - horizontal.X, cf.Position.Y + offsetY, cf.Position.Z - horizontal.Z)
+	runtime.root.CFrame = CFrame.new(position) * facing * runtime.bodyRotation
+
+	vars.enforceLocalTryOnNoCollision()
+	vars.enforceCharacterHidden()
+	vars.setLocalTryOnFirstPersonVisibility(vars.isFirstPersonCamera(character))
+
+	if runtime.animator and next(runtime.slots) ~= nil then
+		local velocity = hrp.AssemblyLinearVelocity
+		local state = humanoid:GetState()
+		local seatPart = humanoid.SeatPart
+		local motion = {
+			speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude,
+			seated = humanoid.Sit or seatPart ~= nil or state == Enum.HumanoidStateType.Seated,
+			climbing = state == Enum.HumanoidStateType.Climbing,
+			swimming = state == Enum.HumanoidStateType.Swimming,
+			jumping = state == Enum.HumanoidStateType.Jumping,
+			falling = state == Enum.HumanoidStateType.Freefall,
+		}
+		local slot = vars.pickEntitySlot(motion, runtime.slots, options.runSpeed)
+		if slot ~= runtime.slot then
+			local old = runtime.slot and runtime.tracks[runtime.slot]
+			if old then pcall(function() old:Stop(0.2) end) end
+			local track = slot and vars.entityGetTrack(runtime, slot)
+			if track then pcall(function() track:Play(0.2) end) end
+			runtime.slot = slot
+		end
+		if runtime.slot == "climb" then
+			local track = runtime.tracks[runtime.slot]
+			if track then pcall(function() track:AdjustSpeed(math.abs(velocity.Y) < 0.1 and 0 or 1) end) end
+		end
+	end
+end
+
+vars.wearEntity = function(data)
+	if vars.localTryOnBuilding then return end
+	local character = vars.LocalPlayer.Character
+	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
+	local hrp = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
+	if not character or not character.Parent or not humanoid or not hrp then
+		vars.showDiagnostics("Entity wear failed.", "Your character (Humanoid + root part) is not available yet.")
+		return
+	end
+
+	vars.tryOnActive = true
+	vars.stopLocalTryOn(true)
+	vars.localTryOnBuildId += 1
+	local buildId = vars.localTryOnBuildId
+	vars.localTryOnBuilding = true
+	vars.Status.Text = "[...] Building entity: " .. tostring(data.DisplayName)
+	vars.clearDiagnostics()
+
+	local function stillCurrent()
+		return vars.scriptAlive and buildId == vars.localTryOnBuildId
+	end
+
+	local model
+	local ok, err = xpcall(function()
+		if not data.Entity or not data.Entity.Template then
+			local info, captureError = vars.captureEntity(data.Path, data.Options)
+			if not info then error(captureError, 0) end
+			data.Entity = info
+			vars.clearPreviewModelCache()
+		end
+		if not stillCurrent() then return end
+		local info = data.Entity
+		local options = vars.normalizeEntityOptions(data.Options)
+
+		model = info.Template:Clone()
+		model.Name = "LocalWearer_LocalTryOn"
+		vars.prepareEntityClone(model, options)
+
+		local playerHeight = 5
+		pcall(function() playerHeight = character:GetExtentsSize().Y end)
+		local entityHeight = info.Bounds and info.Bounds.size.Y or 0
+		local scale = vars.resolveEntityScale(options.scale, entityHeight, playerHeight)
+		local scaleNote = ""
+		if math.abs(scale - 1) > 1e-4 then
+			local scaled = pcall(function() model:ScaleTo(model:GetScale() * scale) end)
+			if not scaled then
+				scale = 1
+				scaleNote = " (ScaleTo failed, worn at native size)"
+			end
+		end
+
+		for _, instance in ipairs(model:GetDescendants()) do
+			if instance:IsA("BasePart") then
+				instance.Anchored = false
+				vars.disableLocalTryOnCollision(instance)
+				instance.LocalTransparencyModifier = 0
+			end
+		end
+		vars.setLocalTryOnConnection("collision", model.DescendantAdded, vars.disableLocalTryOnCollision)
+		vars.setLocalTryOnConnection("preSimulation", vars.RunService.PreSimulation, vars.enforceLocalTryOnNoCollision)
+
+		local root, rootHow = vars.pickEntityRoot(model)
+		if not root then error("entity has no BaseParts", 0) end
+		local glued = vars.weldDetachedParts(model, root)
+		root.Anchored = true
+
+		local parts = {}
+		for _, instance in ipairs(model:GetDescendants()) do
+			if instance:IsA("BasePart") then parts[#parts + 1] = instance end
+		end
+		local bodyRotation = vars.getBodyRotation(root.CFrame)
+		local bounds = vars.computeEntityBounds(parts, root.CFrame, bodyRotation)
+		if not bounds then error("could not measure the entity", 0) end
+
+		local legPart = character:FindFirstChild("Left Leg")
+		local runtime = {
+			model = model, root = root, character = character, humanoid = humanoid, hrp = hrp, legPart = legPart,
+			options = options, bodyRotation = bodyRotation, bounds = bounds, lastYaw = 0,
+			tracks = {}, loadedAnimations = {}, animErrors = {}, slot = nil,
+		}
+		runtime.slots = vars.buildEntitySlots(info.Animations, options.animMap)
+
+		local animator
+		local controller = model:FindFirstChildWhichIsA("Humanoid", true) or model:FindFirstChildWhichIsA("AnimationController", true)
+		if not controller then
+			controller = Instance.new("AnimationController")
+			controller.Parent = model
+		end
+		animator = controller:FindFirstChildOfClass("Animator")
+		if not animator then
+			animator = Instance.new("Animator")
+			animator.Parent = controller
+		end
+		runtime.animator = animator
+
+		-- place before parenting so there is no frame at the wrong spot
+		local look = hrp.CFrame.LookVector
+		local yaw = math.abs(look.Y) < 0.98 and math.atan2(-look.X, -look.Z) or 0
+		runtime.lastYaw = yaw
+		local facing = CFrame.Angles(0, yaw + math.rad(options.yaw), 0)
+		local floorBelow = vars.getPlayerFloorBelowRoot(humanoid, hrp, legPart)
+		local offsetY = options.alignGround and (-floorBelow - bounds.min.Y + options.yOffset) or (-bounds.center.Y + options.yOffset)
+		local horizontal = options.recenter and facing:VectorToWorldSpace(Vector3.new(bounds.center.X, 0, bounds.center.Z)) or Vector3.zero
+		local startPosition = Vector3.new(hrp.Position.X - horizontal.X, hrp.Position.Y + offsetY, hrp.Position.Z - horizontal.Z)
+		local targetRoot = CFrame.new(startPosition) * facing * bodyRotation
+		model:PivotTo(targetRoot * root.CFrame:ToObjectSpace(model:GetPivot()))
+		model.Parent = vars.Workspace
+
+		vars.RunService.Heartbeat:Wait()
+		if not stillCurrent() then return end
+		if not model:IsDescendantOf(vars.Workspace) or not root.Parent then
+			error("the entity was removed right after entering Workspace (this game purges unknown models)", 0)
+		end
+
+		vars.localTryOnModel = model
+		vars.localTryOnRootPart = root
+		vars.localTryOnHiddenInFirstPerson = false
+		vars.entityRuntime = runtime
+		vars.hideCharacterLocally(character)
+		vars.setLocalTryOnConnection("position", vars.RunService.RenderStepped, vars.entityStep)
+		vars.destroyOrphanedLocalTryOnModels(model)
+
+		local slotNames = {}
+		for _, slotName in ipairs({"idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle", "sit"}) do
+			if runtime.slots[slotName] then slotNames[#slotNames + 1] = slotName end
+		end
+		vars.Status.Text = string.format("[OK] Entity worn: %s (scale %.2f%s, root: %s, %d glued, anim slots: %s)",
+			tostring(data.DisplayName), scale, scaleNote, rootHow, glued, #slotNames > 0 and table.concat(slotNames, ",") or "none")
+	end, debug.traceback)
+
+	if not stillCurrent() then
+		if model and not vars.localTryOnModel then pcall(function() model:Destroy() end) end
+		return
+	end
+	vars.localTryOnBuilding = false
+	if not ok then
+		if model then pcall(function() model:Destroy() end) end
+		vars.stopLocalTryOn(false)
+		vars.showDiagnostics("Entity wear failed.", tostring(err))
+	end
+	vars.updateWearButtonState()
+end
+
+local originalStopLocalTryOn = vars.stopLocalTryOn
+vars.stopLocalTryOn = function(preserveActiveState)
+	vars.entityStopRuntime()
+	return originalStopLocalTryOn(preserveActiveState)
+end
+
+-- ---------------------------------------------------------------- list entries + persistence
+
+vars.makeEntityEntry = function(path, displayName, options)
+	local leaf = vars.getEntityLeafName(path)
+	return {
+		Kind = "Entity",
+		Source = "entity",
+		Name = leaf,
+		DisplayName = (displayName and displayName ~= "") and displayName or ("[Entity] " .. leaf),
+		Path = path,
+		Options = vars.normalizeEntityOptions(options),
+		Properties = {},
+		RigType = "Entity",
+		Signature = "entity:" .. string.lower(path),
+		Entity = nil,
+	}
+end
+
+vars.loadEntityFile = function()
+	vars.entityEntries = {}
+	if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
+	local okExists, exists = pcall(isfile, vars.ENTITY_FILE_PATH)
+	if not okExists or not exists then return end
+	local ok, decoded = pcall(function() return vars.HttpService:JSONDecode(readfile(vars.ENTITY_FILE_PATH)) end)
+	if not ok or type(decoded) ~= "table" then return end
+	local list = decoded[tostring(game.PlaceId)]
+	if type(list) ~= "table" then return end
+	for _, saved in ipairs(list) do
+		if type(saved) == "table" and type(saved.Path) == "string" and saved.Path ~= "" then
+			vars.entityEntries[#vars.entityEntries + 1] = vars.makeEntityEntry(saved.Path, saved.DisplayName, saved.Options)
+		end
+	end
+end
+
+vars.saveEntityFile = function()
+	if type(writefile) ~= "function" then return false end
+	pcall(function()
+		if type(makefolder) == "function" and (type(isfolder) ~= "function" or not isfolder(vars.FOLDER_NAME)) then
+			makefolder(vars.FOLDER_NAME)
+		end
+	end)
+	local root = {}
+	pcall(function()
+		if type(isfile) == "function" and isfile(vars.ENTITY_FILE_PATH) then
+			local decoded = vars.HttpService:JSONDecode(readfile(vars.ENTITY_FILE_PATH))
+			if type(decoded) == "table" then root = decoded end
+		end
+	end)
+	local list = {}
+	for _, entry in ipairs(vars.entityEntries) do
+		list[#list + 1] = {Path = entry.Path, DisplayName = entry.DisplayName, Options = entry.Options}
+	end
+	root[tostring(game.PlaceId)] = list
+	return (pcall(function() writefile(vars.ENTITY_FILE_PATH, vars.HttpService:JSONEncode(root)) end))
+end
+
+vars.appendEntityAvatars = function()
+	if not vars.entitiesLoaded then
+		vars.entitiesLoaded = true
+		vars.loadEntityFile()
+	end
+	for _, entry in ipairs(vars.entityEntries) do
+		vars.ui.savedAvatars[#vars.ui.savedAvatars + 1] = entry
+	end
+end
+
+vars.findEntityEntry = function(path)
+	local signature = "entity:" .. string.lower(path)
+	for _, entry in ipairs(vars.entityEntries) do
+		if entry.Signature == signature then return entry end
+	end
+	return nil
+end
+
+vars.deleteEntityAvatar = function(data)
+	if vars.ui.selectedAvatar == data then
+		vars.tryOnActive = false
+		vars.stopLocalTryOn(false)
+		vars.ui.selectedAvatar = nil
+	end
+	for index = #vars.entityEntries, 1, -1 do
+		if vars.entityEntries[index] == data then table.remove(vars.entityEntries, index) end
+	end
+	for index = #vars.ui.savedAvatars, 1, -1 do
+		if vars.ui.savedAvatars[index] == data then table.remove(vars.ui.savedAvatars, index) end
+	end
+	if data.Entity and data.Entity.Template then pcall(function() data.Entity.Template:Destroy() end) end
+	data.Entity = nil
+	vars.clearPreviewModelCache()
+	vars.saveEntityFile()
+	vars.Status.Text = "[OK] Removed entity: " .. tostring(data.DisplayName)
+	vars.clearDiagnostics()
+	vars.populateAvatarList()
+end
+
+vars.entityCleanup = function()
+	vars.entityStopRuntime()
+	for _, entry in ipairs(vars.entityEntries) do
+		if entry.Entity and entry.Entity.Template then pcall(function() entry.Entity.Template:Destroy() end) end
+		entry.Entity = nil
+	end
+end
+
+-- ---------------------------------------------------------------- panel UI
+
+vars.formatEntityReport = function(entry)
+	local info = entry.Entity
+	if not info then
+		return "Not captured yet. It is captured on first wear, or press ADD / UPDATE while the entity is loaded."
+	end
+	local lines = {}
+	lines[#lines + 1] = tostring(entry.Path)
+	lines[#lines + 1] = string.format("%s, %d parts, %d accessories, humanoid: %s", info.SourceClass, info.PartCount, info.AccessoryCount, info.HasHumanoid and "yes" or "no")
+	lines[#lines + 1] = "root: " .. info.RootName .. " (" .. info.RootHow .. ")"
+	if info.Bounds then
+		lines[#lines + 1] = string.format("native size (visible): %.1f x %.1f x %.1f studs, height %.1f", info.Bounds.size.X, info.Bounds.size.Y, info.Bounds.size.Z, info.Bounds.size.Y)
+	end
+	local slots, slotWarnings = vars.buildEntitySlots(info.Animations, entry.Options.animMap)
+	local names = {}
+	for _, slotName in ipairs({"idle", "walk", "run", "jump", "fall", "climb", "swim", "swimidle", "sit"}) do
+		if slots[slotName] then names[#names + 1] = slotName end
+	end
+	local instanceCount, sampledCount = 0, 0
+	for _, anim in ipairs(info.Animations) do
+		if anim.Source == "sampled" then sampledCount += 1 else instanceCount += 1 end
+	end
+	lines[#lines + 1] = string.format("animations: %d in model, %d seen playing%s", instanceCount, sampledCount, info.SampleDone and "" or " (still watching...)")
+	lines[#lines + 1] = "slots: " .. (#names > 0 and table.concat(names, ", ") or "none (entity stays in its default pose)")
+	local unmapped = {}
+	for _, anim in ipairs(info.Animations) do
+		if not vars.classifyEntityAnimation(anim.Name, anim.Group) then unmapped[#unmapped + 1] = anim.Name .. "=" .. anim.Id end
+	end
+	if #unmapped > 0 then lines[#lines + 1] = "unmapped (use the anim map box): " .. table.concat(unmapped, " | ") end
+	lines[#lines + 1] = string.format("removed: %d scripts, %d outside joints, %d outside constraints", info.Removed.Scripts, info.Removed.Joints, info.Removed.Constraints)
+	for _, warning in ipairs(info.Warnings) do lines[#lines + 1] = "! " .. warning end
+	for _, warning in ipairs(slotWarnings) do lines[#lines + 1] = "! anim map: " .. warning end
+	return table.concat(lines, "\n")
+end
+
+vars.buildEntityPanel = function()
