+	panel.BackgroundColor3 = vars.COLORS.Background
+	panel.BorderSizePixel = 0
+	panel.Visible = false
+	panel.ZIndex = Z
+	panel.Parent = vars.Main
+	vars.EntityPanel = panel
+
+	local function styleBox(box, placeholder, size, position)
+		box.Size = size
+		box.Position = position
+		box.BackgroundColor3 = vars.COLORS.Surface3
+		box.BorderSizePixel = 0
+		box.Text = ""
